{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "apex.buffer",
    "name": "ApexBuffer",
    "version": "1.4.2",
    "developer": "Apex",
    "description": "Predictive input buffer. Retimes early clicks, blocks clearly fatal presses/releases when delay cannot save them, share codes, F9 chips.",
    "tags": [
        "gameplay",
        "utility"
    ],
    "resources": {
        "files": [
            "resources/apex-body.fnt",
            "resources/apex-body.png",
            "resources/apex-display.fnt",
            "resources/apex-display.png",
            "resources/apex-logo.png",
            "resources/OFL.txt"
        ]
    },
    "settings": {
        "terminal-title": {
            "type": "title",
            "name": "terminal",
            "platforms": [
                "win",
                "mac"
            ]
        },
        "terminal-enabled": {
            "type": "bool",
            "name": "enable terminal",
            "default": true,
            "platforms": [
                "win",
                "mac"
            ]
        },
        "keybinds-title": {
            "type": "title",
            "name": "keybinds",
            "platforms": [
                "win",
                "mac"
            ]
        },
        "keybind-stage": {
            "type": "keybind",
            "name": "cycle stages",
            "category": "gameplay",
            "default": [
                "F6"
            ],
            "platforms": [
                "win",
                "mac"
            ]
        },
        "keybind-terminal": {
            "type": "keybind",
            "name": "control panel",
            "category": "universal",
            "default": [
                "F9"
            ],
            "platforms": [
                "win",
                "mac"
            ]
        },
        "ui-title": {
            "type": "title",
            "name": "ui customization"
        },
        "ui-primary-color": {
            "type": "color",
            "name": "primary color",
            "default": "#A855F7"
        },
        "ui-secondary-color": {
            "type": "color",
            "name": "secondary color",
            "default": "#D5B4FF"
        },
        "ui-surface-color": {
            "type": "color",
            "name": "surface color",
            "default": "#17131F"
        },
        "ui-text-color": {
            "type": "color",
            "name": "text color",
            "default": "#EFE7F7"
        },
        "ui-glow": {
            "type": "bool",
            "name": "glow",
            "default": true
        },
        "ui-panel-scale": {
            "type": "float",
            "name": "panel scale",
            "default": 0.7,
            "min": 0.4,
            "max": 2.0,
            "step": 0.05
        },
        "ui-font-scale": {
            "type": "float",
            "name": "font scale",
            "default": 1.5,
            "min": 0.8,
            "max": 2.0,
            "step": 0.05
        },
        "mobile-title": {
            "type": "title",
            "name": "mobile",
            "platforms": [
                "android",
                "ios"
            ]
        },
        "mobile-floating-button": {
            "type": "bool",
            "name": "floating af button",
            "default": false,
            "platforms": [
                "android",
                "ios"
            ]
        },
        "gameplay-title": {
            "type": "title",
            "name": "gameplay (basu / assist)"
        },
        "help-sound": {
            "type": "bool",
            "name": "help sound",
            "description": "Sound when the mod retimes an input",
            "default": true
        },
        "block-unsafe-inputs": {
            "type": "bool",
            "name": "block unsafe presses",
            "description": "If a press/release would die soon and delay cannot fix it, cancel that input instead of sending a death click.",
            "default": true
        },
        "delay-window-ms": {
            "type": "int",
            "name": "delay window (ms)",
            "description": "How far early/late a press may be shifted. Higher = can correct presses that are further from the ideal timing (e.g. 50ms early when ideal was 20ms). ~4ms ≈ 1 internal tick step.",
            "default": 50,
            "min": 0,
            "max": 200
        },
        "precision-timing": {
            "type": "bool",
            "name": "precision timing",
            "description": "When delaying an input, pick the delay tick that survives longest (closest to a clean safe timing) instead of the first workable delay.",
            "default": true
        },
        "practice-only": {
            "type": "bool",
            "name": "practice mode only",
            "default": false
        },
        "smart-prediction": {
            "type": "bool",
            "name": "orb / pad / portal prediction",
            "default": true
        },
        "sim-budget-ms": {
            "type": "float",
            "name": "prediction budget (ms)",
            "default": 8.0,
            "min": 1.0,
            "max": 30.0
        },
        "ground-horizon": {
            "type": "int",
            "name": "cube / ball lookahead (ticks)",
            "default": 130,
            "min": 48,
            "max": 240
        },
        "wave-horizon": {
            "type": "int",
            "name": "wave lookahead (ticks)",
            "default": 65,
            "min": 20,
            "max": 160
        },
        "wave-auto-release": {
            "type": "bool",
            "name": "wave auto-release",
            "default": true
        },
        "auto-release-window": {
            "type": "int",
            "name": "auto-release window (ticks)",
            "default": 8,
            "min": 2,
            "max": 24
        },
        "auto-release-normal-runs": {
            "type": "bool",
            "name": "auto-release in normal runs",
            "default": false
        },
        "ship-buffer": {
            "type": "bool",
            "name": "ship buffer",
            "default": true
        },
        "low-latency": {
            "type": "bool",
            "name": "low latency mode",
            "default": false
        },
        "wave-safety-margin": {
            "type": "bool",
            "name": "wave safety margin",
            "default": true
        },
        "show-path": {
            "type": "bool",
            "name": "show prediction path",
            "default": false
        },
        "explain-inputs": {
            "type": "bool",
            "name": "explain inputs in log",
            "default": false
        },
        "avoid-moving-objects": {
            "type": "bool",
            "name": "avoid moving objects",
            "default": false
        },
        "wave-spam-gap": {
            "type": "int",
            "name": "wave spam gap (ticks)",
            "default": 16,
            "min": 4,
            "max": 40
        }
    }
}
